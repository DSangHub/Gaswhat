<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dealer Portal | GasWhat.org</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>
    <!-- Supabase JS Client -->
    <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        brand: {
                            50: '#f0fdf4',
                            100: '#dcfce7',
                            500: '#22c55e',
                            600: '#16a34a',
                            700: '#15803d',
                            900: '#14532d',
                        }
                    }
                }
            }
        }
    </script>
</head>
<body class="bg-slate-100 text-slate-800 font-sans antialiased min-h-screen flex flex-col">

    <!-- TOP NAVIGATION -->
    <header class="bg-slate-900 text-white border-b border-slate-800 sticky top-0 z-40">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
            <div class="flex items-center space-x-3">
                <div class="bg-brand-600 text-white p-1.5 rounded-lg">
                    <i data-lucide="zap" class="w-5 h-5"></i>
                </div>
                <span class="text-xl font-bold tracking-tight">GasWhat<span class="text-brand-500">.org</span> <span class="text-xs text-slate-400 font-normal ml-2">Dealer Portal</span></span>
            </div>

            <!-- Auth Status Bar -->
            <div id="auth-status" class="flex items-center space-x-4">
                <span id="user-display" class="text-xs text-slate-300 font-medium hidden sm:inline">Not Logged In</span>
                <button id="auth-action-btn" onclick="toggleAuthModal()" class="text-xs font-semibold bg-brand-600 hover:bg-brand-500 text-white px-3 py-1.5 rounded-lg transition">
                    Sign In
                </button>
            </div>
        </div>
    </header>

    <!-- DASHBOARD CONTENT (PROTECTED) -->
    <main class="flex-grow max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8">
        
        <!-- LOGIN PROMPT OVERLAY (IF NOT AUTHENTICATED) -->
        <div id="unauth-view" class="bg-white rounded-2xl p-12 text-center border border-slate-200 shadow-sm my-12 max-w-xl mx-auto">
            <div class="bg-slate-100 text-slate-600 w-16 h-16 rounded-full flex items-center justify-center mx-auto mb-4">
                <i data-lucide="lock" class="w-8 h-8"></i>
            </div>
            <h2 class="text-2xl font-bold text-slate-900">Dealer Portal Locked</h2>
            <p class="text-slate-600 text-sm mt-2 mb-6">Please sign in with your dealership account credentials to access high-intent consumer leads.</p>
            <button onclick="toggleAuthModal()" class="bg-brand-600 hover:bg-brand-500 text-white font-bold px-6 py-3 rounded-xl transition shadow-md">
                Sign In to Dashboard
            </button>
        </div>

        <!-- MAIN DASHBOARD VIEW (HIDDEN UNTIL LOGIN) -->
        <div id="dashboard-view" class="hidden space-y-8">
            
            <!-- STATS CARDS -->
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
                <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-sm">
                    <span class="text-xs font-semibold uppercase text-slate-500 tracking-wider">Total Active Leads</span>
                    <div class="text-3xl font-extrabold text-slate-900 mt-2" id="stat-total">0</div>
                </div>
                <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-sm">
                    <span class="text-xs font-semibold uppercase text-slate-500 tracking-wider">New Unclaimed</span>
                    <div class="text-3xl font-extrabold text-brand-600 mt-2" id="stat-new">0</div>
                </div>
                <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-sm">
                    <span class="text-xs font-semibold uppercase text-slate-500 tracking-wider">Contacted</span>
                    <div class="text-3xl font-extrabold text-blue-600 mt-2" id="stat-contacted">0</div>
                </div>
                <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-sm">
                    <span class="text-xs font-semibold uppercase text-slate-500 tracking-wider">Avg. Buyer Savings</span>
                    <div class="text-3xl font-extrabold text-slate-900 mt-2" id="stat-avg-savings">$0/mo</div>
                </div>
            </div>

            <!-- CONTROLS & FILTERS -->
            <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 bg-white p-4 rounded-xl border border-slate-200 shadow-sm">
                <div class="flex items-center space-x-2">
                    <span class="text-sm font-semibold text-slate-700">Filter Status:</span>
                    <select id="status-filter" onchange="fetchLeads()" class="bg-slate-50 border border-slate-300 rounded-lg px-3 py-1.5 text-sm focus:ring-2 focus:ring-brand-500 focus:outline-none">
                        <option value="ALL">All Statuses</option>
                        <option value="NEW" selected>NEW (Unclaimed)</option>
                        <option value="CONTACTED">CONTACTED</option>
                        <option value="CLOSED">CLOSED</option>
                    </select>
                </div>
                <button onclick="fetchLeads()" class="inline-flex items-center space-x-1 text-xs font-semibold text-slate-700 bg-slate-100 hover:bg-slate-200 px-3 py-2 rounded-lg border border-slate-300 transition">
                    <i data-lucide="refresh-cw" class="w-3.5 h-3.5"></i>
                    <span>Refresh Leads</span>
                </button>
            </div>

            <!-- LEADS TABLE -->
            <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
                <div class="px-6 py-4 border-b border-slate-200 flex justify-between items-center">
                    <h3 class="font-bold text-slate-900">Incoming Buyer Leads</h3>
                    <span class="text-xs text-slate-500">Live feed updated in real-time</span>
                </div>

                <div class="overflow-x-auto">
                    <table class="w-full text-left border-collapse">
                        <thead>
                            <tr class="bg-slate-50 border-b border-slate-200 text-xs uppercase font-semibold text-slate-500">
                                <th class="py-3 px-6">Consumer</th>
                                <th class="py-3 px-6">Vehicle Transition</th>
                                <th class="py-3 px-6">Calculated Savings</th>
                                <th class="py-3 px-6">ZIP Code</th>
                                <th class="py-3 px-6">Status</th>
                                <th class="py-3 px-6 text-right">Action</th>
                            </tr>
                        </thead>
                        <tbody id="leads-table-body" class="divide-y divide-slate-100 text-sm">
                            <!-- Populated via JavaScript -->
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </main>

    <!-- AUTHENTICATION MODAL -->
    <div id="auth-modal" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4">
        <div class="bg-white rounded-2xl max-w-md w-full p-6 sm:p-8 relative shadow-2xl">
            <button onclick="toggleAuthModal()" class="absolute top-4 right-4 text-slate-400 hover:text-slate-600">
                <i data-lucide="x" class="w-6 h-6"></i>
            </button>
            <h3 class="text-2xl font-bold text-slate-900">Dealer Authentication</h3>
            <p class="text-sm text-slate-600 mt-1">Sign in using your Supabase registered dealership account.</p>

            <form onsubmit="handleSignIn(event)" class="mt-6 space-y-4">
                <div>
                    <label class="block text-xs font-semibold text-slate-600 uppercase mb-1">Email Address</label>
                    <input type="email" id="auth-email" required placeholder="dealer@valleyhyundai.com" class="w-full border border-slate-300 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-brand-500 focus:outline-none">
                </div>
                <div>
                    <label class="block text-xs font-semibold text-slate-600 uppercase mb-1">Password</label>
                    <input type="password" id="auth-password" required placeholder="••••••••" class="w-full border border-slate-300 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-brand-500 focus:outline-none">
                </div>
                <button type="submit" id="auth-submit-btn" class="w-full bg-brand-600 hover:bg-brand-500 text-white font-bold py-3 rounded-lg transition shadow-md">
                    Sign In
                </button>
            </form>
        </div>
    </div>

    <!-- JAVASCRIPT LOGIC -->
    <script>
        // Supabase Credentials (Match your project credentials)
        const SUPABASE_URL = 'https://YOUR_SUPABASE_PROJECT_ID.supabase.co';
        const SUPABASE_ANON_KEY = 'YOUR_SUPABASE_ANON_KEY';
        const supabase = supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY);

        let currentUser = null;

        document.addEventListener('DOMContentLoaded', async () => {
            lucide.createIcons();
            
            // Check active session
            const { data: { session } } = await supabase.auth.getSession();
            if (session) {
                currentUser = session.user;
                updateAuthUI();
                fetchLeads();
            }

            // Listen for auth state changes
            supabase.auth.onAuthStateChange((_event, session) => {
                currentUser = session ? session.user : null;
                updateAuthUI();
                if (currentUser) fetchLeads();
            });
        });

        function updateAuthUI() {
            const unauthView = document.getElementById('unauth-view');
            const dashboardView = document.getElementById('dashboard-view');
            const userDisplay = document.getElementById('user-display');
            const authActionBtn = document.getElementById('auth-action-btn');

            if (currentUser) {
                unauthView.classList.add('hidden');
                dashboardView.classList.remove('hidden');
                userDisplay.innerText = currentUser.email;
                authActionBtn.innerText = 'Sign Out';
                authActionBtn.onclick = handleSignOut;
            } else {
                unauthView.classList.remove('hidden');
                dashboardView.classList.add('hidden');
                userDisplay.innerText = 'Not Logged In';
                authActionBtn.innerText = 'Sign In';
                authActionBtn.onclick = toggleAuthModal;
            }
        }

        async function handleSignIn(e) {
            e.preventDefault();
            const email = document.getElementById('auth-email').value;
            const password = document.getElementById('auth-password').value;
            const submitBtn = document.getElementById('auth-submit-btn');

            submitBtn.disabled = true;
            submitBtn.innerText = 'Authenticating...';

            const { data, error } = await supabase.auth.signInWithPassword({ email, password });

            submitBtn.disabled = false;
            submitBtn.innerText = 'Sign In';

            if (error) {
                alert('Authentication failed: ' + error.message);
                return;
            }

            toggleAuthModal();
        }

        async function handleSignOut() {
            await supabase.auth.signOut();
        }

        function toggleAuthModal() {
            const modal = document.getElementById('auth-modal');
            modal.classList.toggle('hidden');
        }

        async function fetchLeads() {
            const statusFilter = document.getElementById('status-filter').value;
            
            let query = supabase.from('leads').select('*').order('created_at', { ascending: false });

            if (statusFilter !== 'ALL') {
                query = query.eq('status', statusFilter);
            }

            const { data: leads, error } = await query;

            if (error) {
                console.error('Error fetching leads:', error);
                return;
            }

            renderLeads(leads || []);
            updateMetrics(leads || []);
        }

        function renderLeads(leads) {
            const tbody = document.getElementById('leads-table-body');
            tbody.innerHTML = '';

            if (leads.length === 0) {
                tbody.innerHTML = `
                    <tr>
                        <td colspan="6" class="py-8 text-center text-slate-400 text-sm">
                            No leads found matching the selected status.
                        </td>
                    </tr>
                `;
                return;
            }

            leads.forEach(lead => {
                const statusBadge = getStatusBadge(lead.status);
                
                tbody.innerHTML += `
                    <tr class="hover:bg-slate-50/80 transition">
                        <td class="py-4 px-6">
                            <div class="font-bold text-slate-900">${lead.consumer_name}</div>
                            <div class="text-xs text-slate-500">${lead.consumer_email} • ${lead.consumer_phone || 'No Phone'}</div>
                        </td>
                        <td class="py-4 px-6">
                            <div class="text-xs font-semibold text-slate-600">Trading: ${lead.current_vehicle_desc || 'Unknown Vehicle'}</div>
                            <div class="text-xs text-brand-600 font-bold">Target: ${lead.target_vehicle_desc || 'EV'}</div>
                        </td>
                        <td class="py-4 px-6">
                            <span class="font-bold text-brand-600">+$${lead.est_monthly_savings}/mo</span>
                        </td>
                        <td class="py-4 px-6 text-xs text-slate-600 font-mono">
                            ${lead.consumer_zip}
                        </td>
                        <td class="py-4 px-6">
                            ${statusBadge}
                        </td>
                        <td class="py-4 px-6 text-right">
                            <select onchange="updateLeadStatus('${lead.id}', this.value)" class="text-xs border border-slate-300 rounded px-2 py-1 bg-white focus:outline-none">
                                <option value="NEW" ${lead.status === 'NEW' ? 'selected' : ''}>NEW</option>
                                <option value="CONTACTED" ${lead.status === 'CONTACTED' ? 'selected' : ''}>CONTACTED</option>
                                <option value="CLOSED" ${lead.status === 'CLOSED' ? 'selected' : ''}>CLOSED</option>
                            </select>
                        </td>
                    </tr>
                `;
            });

            lucide.createIcons();
        }

        async function updateLeadStatus(leadId, newStatus) {
            const { error } = await supabase
                .from('leads')
                .update({ status: newStatus })
                .eq('id', leadId);

            if (error) {
                alert('Failed to update lead: ' + error.message);
                return;
            }

            fetchLeads();
        }

        function getStatusBadge(status) {
            switch(status) {
                case 'NEW':
                    return `<span class="bg-emerald-100 text-emerald-800 text-xs font-bold px-2 py-0.5 rounded">NEW</span>`;
                case 'CONTACTED':
                    return `<span class="bg-blue-100 text-blue-800 text-xs font-bold px-2 py-0.5 rounded">CONTACTED</span>`;
                case 'CLOSED':
                    return `<span class="bg-slate-100 text-slate-800 text-xs font-bold px-2 py-0.5 rounded">CLOSED</span>`;
                default:
                    return `<span class="bg-slate-100 text-slate-600 text-xs font-bold px-2 py-0.5 rounded">${status}</span>`;
            }
        }

        function updateMetrics(leads) {
            document.getElementById('stat-total').innerText = leads.length;
            document.getElementById('stat-new').innerText = leads.filter(l => l.status === 'NEW').length;
            document.getElementById('stat-contacted').innerText = leads.filter(l => l.status === 'CONTACTED').length;

            if (leads.length > 0) {
                const totalSavings = leads.reduce((sum, lead) => sum + (parseFloat(lead.est_monthly_savings) || 0), 0);
                const avg = Math.round(totalSavings / leads.length);
                document.getElementById('stat-avg-savings').innerText = `$${avg}/mo`;
            }
        }
    </script>
</body>
</html>
