-- Enable RLS on both tables
ALTER TABLE leads ENABLE ROW LEVEL SECURITY;
ALTER TABLE dealerships ENABLE ROW LEVEL SECURITY;

-- 1. Allow public visitors to submit new leads
CREATE POLICY "Allow public lead creation" 
ON leads FOR INSERT 
TO anon 
WITH CHECK (true);

-- 2. Allow public visitors to register new dealerships
CREATE POLICY "Allow public dealer registration" 
ON dealerships FOR INSERT 
TO anon 
WITH CHECK (true);

-- 3. Allow public visitors to view active dealerships
CREATE POLICY "Allow public viewing of active dealerships" 
ON dealerships FOR SELECT 
TO anon 
USING (is_active = true);
